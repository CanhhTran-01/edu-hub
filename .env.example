DBMS_CONNECTION=jdbc:postgresql://localhost:5432/your_db_name
DBMS_USERNAME=your_username
DBMS_PASSWORD=your_password

# Identity / JWT
JWT_SECRET=your_base64_encoded_secret_with_at_least_32_random_bytes
SPRING_PROFILES_ACTIVE=dev

# Optional development administrator
DEV_ADMIN_USERNAME=your_dev_admin_username
DEV_ADMIN_PASSWORD=your_dev_admin_password
DEV_ADMIN_EMAIL=your_dev_admin_email@example.com

# Gmail SMTP sender used for account notifications
GMAIL_ADDRESS=your_sender@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
