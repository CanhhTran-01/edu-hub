DBMS_CONNECTION=jdbc:postgresql://localhost:5432/your_db_name
DBMS_USERNAME=your_username
DBMS_PASSWORD=your_password

# Cấu hình xác thực và JWT; các thời hạn dùng đơn vị của Duration.
JWT_SECRET=your_base64_encoded_secret_with_at_least_32_random_bytes
JWT_ACCESS_TOKEN_LIFETIME=15m
JWT_REFRESH_TOKEN_LIFETIME=7d
AUTH_MAX_FAILED_LOGINS=5
AUTH_TEMPORARY_LOCK_DURATION=15m
PASSWORD_MINIMUM_LENGTH=8
# Mật khẩu do hệ thống cấp, không áp dụng kiểm tra độ mạnh; người dùng phải đổi ở lần đăng nhập đầu tiên.
INITIAL_ACCOUNT_PASSWORD=12345
SPRING_PROFILES_ACTIVE=dev

# Tài khoản quản trị hệ thống được tạo khi username chưa tồn tại.
APP_INIT_SYSTEM_ADMIN_USERNAME=sysadmin
APP_INIT_SYSTEM_ADMIN_PASSWORD=sysadmin@123
APP_INIT_SYSTEM_ADMIN_EMAIL=

# Gmail SMTP sender used for account notifications
GMAIL_ADDRESS=your_sender@gmail.com
GMAIL_APP_PASSWORD=your_google_app_password
