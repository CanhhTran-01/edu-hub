# Active Spring profile (loads application-<profile>.yml): dev | prod
# SPRING_PROFILES_ACTIVE=

# --- Database (PostgreSQL) ---
DBMS_CONNECTION=jdbc:postgresql://localhost:5432/your_db_name
DBMS_USERNAME=your_db_username
DBMS_PASSWORD=your_db_password

# --- Cấu hình xác thực và JWT; các thời hạn dùng đơn vị của Duration ---
JWT_SECRET=your_base64_encoded_secret_with_at_least_32_random_bytes
# JWT_ACCESS_TOKEN_LIFETIME=
# JWT_REFRESH_TOKEN_LIFETIME=
# AUTH_MAX_FAILED_LOGINS=
# AUTH_TEMPORARY_LOCK_DURATION=15m

# Job dọn token hết hạn lúc 02:00 giờ Việt Nam; bỏ comment để đổi lịch cron sáu trường.
# REFRESH_TOKEN_CLEANUP_CRON=0 0 2 * * *

# --- Mật khẩu do hệ thống cấp, không áp dụng kiểm tra độ mạnh; người dùng phải đổi ở lần đăng nhập đầu tiên ---
# PASSWORD_MINIMUM_LENGTH=
INITIAL_ACCOUNT_PASSWORD=12345

# --- Tài khoản quản trị hệ thống được tạo khi username chưa tồn tại ---
APP_INIT_SYSTEM_ADMIN_USERNAME=system_admin
APP_INIT_SYSTEM_ADMIN_PASSWORD=postman@123
# APP_INIT_SYSTEM_ADMIN_EMAIL=

# --- Gmail SMTP sender used for account notifications ---
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Notification mail ---
# NOTIFICATION_MAIL_BRAND_NAME=
NOTIFICATION_MAIL_LOGIN_URL=
NOTIFICATION_MAIL_SUPPORT_EMAIL=

# --- Năm phạm vi bắt buộc; Hai giới hạn tín chỉ là nguồn khởi tạo, có thể thiết lập qua SystemConfig ---
ENROLLMENT_FIRST_SUPPORTED_ADMISSION_YEAR=
ENROLLMENT_MINIMUM_CREDITS=
ENROLLMENT_MAXIMUM_CREDITS=
# ENROLLMENT_GRADE_CORRECTION_WINDOW=

# --- Timetable ---
# TIMETABLE_SOLVING_SECONDS=
# TIMETABLE_MAXIMUM_SESSIONS=

# --- Gemini AI ---
GOOGLE_API_KEY=
# GEMINI_CHAT_MODEL=
# AI_EMBEDDING_MODEL=gemini-embedding-001
# AI_EMBEDDING_MODEL_VERSION=001
# AI_REQUEST_TIMEOUT=30s
# AI_INGESTION_TIMEOUT=10m
# AI_QUESTIONS_PER_MINUTE=10
